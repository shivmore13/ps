class_name Levels
extends RefCounted
## Static data table describing the four realms.
##
## Every realm is generated by LevelBase from these dictionaries, so the layout,
## hazards, collectibles and boss of each level live in one readable place.
## Compact array rows are converted to typed values by LevelBase.


## Ability granted in each realm (the anti-physics "spell" of that world).
const ABILITIES := {
	"gravity_reverse": "Gravity Reversal",
	"time_freeze": "Time Freeze",
	"time_slow": "Time Slow & Rewind",
}


static func ability_for(index: int) -> String:
	var lv: Dictionary = LEVELS[clampi(index, 0, LEVELS.size() - 1)]
	return String(lv.get("ability", ""))


static func ability_display(id: String) -> String:
	return String(ABILITIES.get(id, id))


static func level_name(index: int) -> String:
	var lv: Dictionary = LEVELS[clampi(index, 0, LEVELS.size() - 1)]
	return String(lv.name)


static func realm_name(index: int) -> String:
	var lv: Dictionary = LEVELS[clampi(index, 0, LEVELS.size() - 1)]
	return String(lv.realm)


